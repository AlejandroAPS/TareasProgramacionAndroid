<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/negro_fondo">

    <View
        android:id="@+id/vistaSuperior"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="@color/gris_boton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloInicioSesion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INICIO SESION"
        android:textColor="@color/white"
        android:textSize="50sp"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_italic_variablefont_wdth_wght"
        app:layout_constraintBottom_toBottomOf="@+id/vistaSuperior"
        app:layout_constraintEnd_toEndOf="@+id/vistaSuperior"
        app:layout_constraintStart_toStartOf="@+id/vistaSuperior"
        app:layout_constraintTop_toTopOf="@+id/vistaSuperior" />


    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginTop="50dp"
        app:srcCompat="@drawable/eskinazo_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vistaSuperior"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/gris_boton"
        android:textColorHint="@color/gris_boton"
        android:hint="Escribe tu nombre aquí"
        android:inputType="text"
        android:minHeight="48dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView1"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/etContra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/gris_boton"
        android:textColorHint="@color/gris_boton"
        android:hint="Escriba la contraseña"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etNombre"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button1"
        android:layout_width="250dp"
        android:layout_height="80dp"
        android:text="Iniciar Sesión"
        android:textSize="25sp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/gris_boton"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:fontFamily="@font/roboto_variablefont_wdth_wght"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etContra"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvOlvidoContra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Has olvidado tu contraseña?"
        android:textColor="#1A73E8"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button1" />

    <Button
        android:id="@+id/buttonRegistro"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Registrarse"
        android:textSize="25dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/gris_boton"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:fontFamily="@font/roboto_variablefont_wdth_wght"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvOlvidoContra"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>