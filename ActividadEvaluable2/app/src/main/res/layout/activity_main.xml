<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla principal.
    Menú con dos tarjetas grandes (audio e imagen) para acceder a cada sección.
    Toda la composición se resuelve con ConstraintLayout.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    tools:context=".MainActivity">

    <!-- Cabecera degradada -->
    <View
        android:id="@+id/hero"
        android:layout_width="0dp"
        android:layout_height="240dp"
        android:background="@drawable/bg_hero"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Círculo decorativo de la cabecera -->
    <View
        android:id="@+id/glow"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:background="@drawable/bg_glow_circle"
        android:translationX="55dp"
        android:translationY="-45dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/hero" />

    <!-- Etiqueta superior -->
    <TextView
        android:id="@+id/txtTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="52dp"
        android:letterSpacing="0.2"
        android:text="@string/main_tag"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/hero" />

    <!-- Título de la aplicación -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/main_title"
        android:textColor="@color/white"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTag" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/main_subtitle"
        android:textColor="#E8FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitle" />

    <!-- Zona desplazable con las dos secciones -->
    <ScrollView
        android:id="@+id/scrollPrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ==================== TARJETA AUDIO ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/main_audio_title"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="@color/audio_soft"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/iconAudio"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_audio"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="14dp"
                        android:src="@drawable/ic_music"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/accent_coral" />

                    <TextView
                        android:id="@+id/tagAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:letterSpacing="0.15"
                        android:text="@string/main_audio_tag"
                        android:textColor="@color/accent_coral"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrowAudio"
                        app:layout_constraintStart_toEndOf="@id/iconAudio"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/titleAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/main_audio_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrowAudio"
                        app:layout_constraintStart_toEndOf="@id/iconAudio"
                        app:layout_constraintTop_toBottomOf="@id/tagAudio" />

                    <TextView
                        android:id="@+id/descAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="8dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/main_audio_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/arrowAudio"
                        app:layout_constraintStart_toEndOf="@id/iconAudio"
                        app:layout_constraintTop_toBottomOf="@id/titleAudio" />

                    <ImageView
                        android:id="@+id/arrowAudio"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:layout_constraintBottom_toBottomOf="@id/iconAudio"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/iconAudio"
                        app:tint="@color/text_secondary" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== TARJETA IMAGEN ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImagen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:contentDescription="@string/main_image_title"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAudio"
                app:rippleColor="@color/image_soft"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/iconImagen"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_imagen"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="14dp"
                        android:src="@drawable/ic_image"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/accent_blue" />

                    <TextView
                        android:id="@+id/tagImagen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:letterSpacing="0.15"
                        android:text="@string/main_image_tag"
                        android:textColor="@color/accent_blue"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrowImagen"
                        app:layout_constraintStart_toEndOf="@id/iconImagen"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/titleImagen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/main_image_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/arrowImagen"
                        app:layout_constraintStart_toEndOf="@id/iconImagen"
                        app:layout_constraintTop_toBottomOf="@id/tagImagen" />

                    <TextView
                        android:id="@+id/descImagen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="8dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/main_image_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/arrowImagen"
                        app:layout_constraintStart_toEndOf="@id/iconImagen"
                        app:layout_constraintTop_toBottomOf="@id/titleImagen" />

                    <ImageView
                        android:id="@+id/arrowImagen"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:layout_constraintBottom_toBottomOf="@id/iconImagen"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/iconImagen"
                        app:tint="@color/text_secondary" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pie de página -->
            <TextView
                android:id="@+id/txtFooter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/main_footer"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardImagen" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
